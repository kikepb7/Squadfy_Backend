# Copy to .env and fill in. Never commit .env.
# The app reads .env automatically when started from the repository root (IntelliJ, ./gradlew :app:bootRun);
# real environment variables (e.g. an IntelliJ run configuration) take precedence over it.
# Defaults in application.yml already work with `docker compose up` for local development;
# set these to point at real infrastructure (staging/production).

SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (e.g. Supabase pooler: jdbc:postgresql://<host>:5432/postgres?sslmode=require)
DB_URL=jdbc:postgresql://localhost:5432/squadfy
DB_USERNAME=squadfy
DB_PASSWORD=squadfy

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# RabbitMQ (CloudAMQP: RABBITMQ_SSL_ENABLED=true, RABBITMQ_PORT=5671 and RABBITMQ_VHOST=<your vhost>)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false

# SMTP (Mailgun: smtp.mailgun.org, 587, auth + starttls). Local: Mailpit on 1025, UI on http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@squadfy.local

# Auth: base64 secret of at least 256 bits, e.g. `openssl rand -base64 32`
JWT_SECRET_BASE64=
JWT_EXPIRATION_MINUTES=15

# Public URLs
APP_PUBLIC_URL=http://localhost:8080
# App screen (deep link) or web page opened from the password reset email; receives ?token=...
RESET_PASSWORD_URL=squadfy://reset-password
WEBSOCKET_ALLOWED_ORIGIN=http://localhost:8080

# Supabase Storage
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_KEY=

# Firebase Admin SDK service account (file: or classpath: resource). FIREBASE_ENABLED=false skips push notifications.
FIREBASE_ENABLED=true
# Optional: restrict Android pushes to this applicationId (must match the app exactly, including flavors)
FIREBASE_ANDROID_PACKAGE=
FIREBASE_CREDENTIALS_PATH=classpath:firebase-credentials/squadfy-backend-firebase-adminsdk.json

# Production only
RATE_LIMIT_ENABLED=true
